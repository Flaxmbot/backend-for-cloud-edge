# Backend Server Environment Variables

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Catbox.moe Configuration
# No API key required - Catbox.moe is free and anonymous
# Files are uploaded to catbox.moe and stored permanently
# Max file size: 200MB per file

# Optional: User hash for file management (get from catbox.moe)
# CATBOX_USER_HASH=your_user_hash_here

# Gmail OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable Gmail API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:3001/api/gmail/callback
GMAIL_CLIENT_ID=your_gmail_client_id_here.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
