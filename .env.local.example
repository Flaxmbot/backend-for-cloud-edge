# Backend Server Environment Variables
# Copy this file to .env and customize as needed

# ============================================================================
# Server Configuration
# ============================================================================

# Port the server will run on
PORT=3001

# Environment (development, production, test)
NODE_ENV=development

# ============================================================================
# CORS Configuration
# ============================================================================

# Comma-separated list of allowed origins
# Development: http://localhost:5173,http://localhost:3000
# Production: https://yourdomain.com,https://www.yourdomain.com

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Catbox.moe Configuration (OPTIONAL)
# ============================================================================

# User hash for file management (optional)
# Get this from https://catbox.moe/ by creating an account
# This allows you to manage uploaded files
# Leave empty for anonymous uploads

# CATBOX_USER_HASH=your_user_hash_here

# ============================================================================
# Notes
# ============================================================================
# - Catbox.moe doesn't require an API key
# - Files are uploaded anonymously by default
# - User hash is only needed if you want to manage files
# - Max file size: 200MB per file
# - Storage: Unlimited and free
